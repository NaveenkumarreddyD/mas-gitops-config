# envs/drroc4.env — complete
# Renderer inputs. Active install reads committed YAML under drroc4/drroc4; Argo/Helm don't read this file.

# ── Identity ──────────────────────────────────────────────
ACCOUNT_ID=drroc4
REGION_ID=lac1
CLUSTER_ID=drroc4
INSTANCE_ID=drgitopsapp
WORKSPACE_ID=drgitopswks
CLUSTER_URL=https://kubernetes.default.svc
MAS_DOMAIN=drgitopsapp.apps.drroc4.lac1.biz
OPERATIONAL_MODE=nonproduction              # production | nonproduction ONLY

# ── Version pins ──────────────────────────────────────────
MAS_CATALOG_IMAGE=icr.io/cpopen/ibm-maximo-operator-catalog
MAS_CATALOG_VERSION=v9-250925-amd64         # pins MAS 8.11.26 / Manage 8.7.24 / SLS 3.12.2
MAS_CHANNEL=8.11.x
MAS_APP_CHANNEL=8.7.x
SLS_CHANNEL=3.x
MAS_EDITION=essentials-maintenance

# ── Manage / storage / DB ─────────────────────────────────
MANAGE_AUTO_GENERATE_ENCRYPTION_KEYS=true   # true=fresh DB; false=reuse AWS manage-crypto
RWX_STORAGE_CLASS=isilon
MANAGE_ATTACHMENT_PROVIDER=s3-migration      # filestorage | s3-migration | s3  (never empty)
SERVER_TIMEZONE=America/Chicago
DB_SCHEMA=maximo
DB_TABLESPACE=MAX_DATA
DB_INDEXSPACE=MAX_INDEX

# ── DRO ───────────────────────────────────────────────────
DRO_NAMESPACE=ibm-software-central
DRO_CONTACT_EMAIL=Najeeb.Mehboob@spireenergy.com
DRO_CONTACT_FIRSTNAME=Najeeb
DRO_CONTACT_LASTNAME=Mehboob

# ── Per-bundle server.xml (opt-in; empty = operator default) ──
MANAGE_CRON_ASC_

MANAGE_UI_ASC_

MANAGE_MEA_ASC_

MANAGE_JMS_ASC_
MANAGE_REPORT_ASC_B64=


# ── Renderer-only flags (not passed to IBM charts) ────────
GITOPS_OWNS_CERT_MANAGER=false               # cert-manager is a cluster prereq, not gitops-managed
SHARED_CLUSTER_SKIP=                         # low-level render override; normally empty
MAS_MANUAL_CERT_MGMT=true                # false=MAS self-signs core cert; true=seed certs/public
