# Optional recovery-renderer inputs. The active installation reads the committed
# YAML under doc4/doc4; Helm and Argo CD do not read this .env file directly.
ACCOUNT_ID=doc4
REGION_ID=lac1
CLUSTER_ID=doc4
INSTANCE_ID=dmasapp
WORKSPACE_ID=dmaswks

CLUSTER_URL=https://kubernetes.default.svc
MAS_DOMAIN=dmasapp.apps.doc4.lac1.biz
OPERATIONAL_MODE=nonproduction

MAS_CATALOG_IMAGE=icr.io/cpopen/ibm-maximo-operator-catalog
MAS_CATALOG_VERSION=v9-250925-amd64    # master version pin: MAS 8.11.26 / Manage 8.7.24 / SLS 3.12.2
MAS_CHANNEL=8.11.x
MAS_APP_CHANNEL=8.7.x
SLS_CHANNEL=3.x
MAS_EDITION=essentials-maintenance

MANAGE_AUTO_GENERATE_ENCRYPTION_KEYS=true   # true=MAS generates keys (fresh DB); false=use Vault manage-crypto (reused DB)

RWX_STORAGE_CLASS=isilon
DRO_NAMESPACE=ibm-software-central
DRO_CONTACT_EMAIL=Najeeb.Mehboob@spireenergy.com
DRO_CONTACT_FIRSTNAME=Najeeb
DRO_CONTACT_LASTNAME=Mehboob
SERVER_TIMEZONE=America/Chicago
DB_SCHEMA=maximo
DB_TABLESPACE=MAX_DATA
DB_INDEXSPACE=MAX_INDEX

# base64 of the ui+cron JMS-client server.xml. Regenerated for doc4's JMS host
# (dmasapp-dmaswks-jms.mas-dmasapp-manage.svc). Regenerate if the instance/workspace changes.
MANAGE_CRON_ASC_

MANAGE_UI_ASC_

MANAGE_MEA_ASC_

MANAGE_JMS_ASC_

# Renderer-only file selection. These values are not passed to an IBM chart.
GITOPS_OWNS_CERT_MANAGER=false
SHARED_CLUSTER_SKIP=

# false: MAS auto-generates a self-signed core cert. true: provide it (seed certs/public).
MAS_MANUAL_CERT_MGMT=false

